import torch.nn.functional as F

model = VoiceClassifier().to(DEVICE)
model.load_state_dict(torch.load('./checkpoints/voice_model.pth'))
model.eval()


def predict_voice(file_path):
    y, sr = librosa.load(file_path, sr=16000)

    y = librosa.util.fix_length(y, size=16000 * 5)
    y = librosa.util.normalize(y)

    x = torch.tensor(y, dtype=torch.float32)
    x = x.unsqueeze(0).unsqueeze(0).to(DEVICE)

    with torch.no_grad():
        logits = model(x)
        probs = F.softmax(logits, dim=1)

    phishing_prob = probs[0][1].item() * 100

    if phishing_prob >= 70:
        result = '위험'
    elif phishing_prob >= 40:
        result = '주의'
    else:
        result = '안전'

    print(f'보이스피싱 의심 확률: {phishing_prob:.2f}%')
    print(f'판정: {result}')


predict_voice('sample.wav')
