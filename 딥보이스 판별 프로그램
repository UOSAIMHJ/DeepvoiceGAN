import os
import librosa
import soundfile as sf
import noisereduce as nr
from pydub import AudioSegment
from tqdm import tqdm

TARGET_SR = 16000
TARGET_DURATION = 5
TARGET_LENGTH = TARGET_SR * TARGET_DURATION

input_root = './dataset'
output_root = './processed'
os.makedirs(output_root, exist_ok=True)


def convert_audio(file_path):
    ext = file_path.split('.')[-1].lower()

    if ext in ['mp3', 'm4a']:
        audio = AudioSegment.from_file(file_path)
        wav_path = file_path.rsplit('.', 1)[0] + '.wav'
        audio.export(wav_path, format='wav')
        return wav_path

    return file_path


def preprocess_audio(file_path, save_path):
    y, sr = librosa.load(file_path, sr=TARGET_SR)

    reduced = nr.reduce_noise(y=y, sr=sr)

    if len(reduced) > TARGET_LENGTH:
        reduced = reduced[:TARGET_LENGTH]
    else:
        pad = TARGET_LENGTH - len(reduced)
        reduced = librosa.util.fix_length(reduced, size=TARGET_LENGTH)

    reduced = librosa.util.normalize(reduced)

    sf.write(save_path, reduced, TARGET_SR)


for cls in ['real', 'phishing']:
    input_dir = os.path.join(input_root, cls)
    save_dir = os.path.join(output_root, cls)
    os.makedirs(save_dir, exist_ok=True)

    for f in tqdm(os.listdir(input_dir)):
        src = os.path.join(input_dir, f)
        src = convert_audio(src)

        save_path = os.path.join(save_dir, f.split('.')[0] + '.wav')
        preprocess_audio(src, save_path)

